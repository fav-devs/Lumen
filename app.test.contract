// Seat View on a phone-sized window. At 19:45 F8, B4 and I10 are free and I12 is taken.
size 390x844

test "the map opens at 19:45 with nothing picked"
  expect tree has "seat-F8"
  expect text "picked" == "Choose your seat"
  expect disabled "continue"
  expect disabled "seat-I12"

test "a picked seat is priced, and picking it again lets it go"
  tap "seat-F8"
  clock data
  expect text "picked" == "Row F · Seat 8"
  expect text "price" == "€12.50"
  tap "seat-F8"
  expect text "picked" == "Choose your seat"

test "a recliner costs more"
  tap "seat-I10"
  clock data
  expect text "price" == "€16.00"

test "continue flies to the seat and shows the view from it"
  tap "seat-B4"
  clock data
  tap "continue"
  clock +2600
  clock data
  expect state phase == "view"
  expect tree has "hall"
  expect text "view-label" == "View from B4"
  expect text "seat-label" == "UP CLOSE"
  expect text "stat-distance" == "6.4 m"
  expect text "stat-fov" == "85°"

test "a drag looks around from the seat"
  tap "seat-F8"
  tap "continue"
  clock +2600
  tap "scene" drag -100 0
  expect state lookYaw == 0.4

test "change seat flies back to the map with the seat still picked"
  tap "seat-F8"
  tap "continue"
  clock +2600
  tap "change-seat"
  clock +2600
  expect state phase == "map"
  expect text "picked" == "Row F · Seat 8"

test "booking takes the seat"
  tap "seat-F8"
  tap "continue"
  clock +2600
  clock data
  tap "book"
  clock data
  expect text "booked-label" == "BOOKED"
  tap "done"
  clock +2600
  clock data
  expect state phase == "map"
  expect disabled "seat-F8"
  expect text "picked" == "Choose your seat"

test "another showtime has its own free seats"
  tap "show-0"
  clock data
  expect state show == 0
  expect text "picked" == "Choose your seat"

test "a wide window keeps the map and the seat card in a sidebar"
  resize 1440x900
  expect tree has "sidebar"
  tap "seat-F8"
  clock data
  expect text "picked" == "Row F · Seat 8"
  tap "continue"
  clock +2600
  clock data
  expect tree has "card"
  expect text "seat-label" == "SWEET SPOT"
  expect text "view-label" == "View from F8"
